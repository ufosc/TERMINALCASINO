# casino/screens/home.py

from textual.app import ComposeResult
from textual.screen import Screen
from textual.widgets import Header, Footer, Button, Label, Input
from textual.containers import Container, Vertical
from textual.binding import Binding


# Game IDs must exactly match the keys in GAME_HANDLERS in main.py
GAMES = [
    ("🃏  Blackjack (U.S.)",  "blackjack (U.S.)"),
    ("🃏  Blackjack (E.U.)",  "blackjack (E.U.)"),
    ("🎰  Slots",             "slots"),
    ("♠️  Poker",             "poker"),
    ("🔴  Roulette",          "roulette"),
    ("🔴  European Roulette", "european roulette"),
    ("🎴  Uno",               "uno"),
]


class HomePage(Screen):
    """
    Terminal Casino homepage screen.

    Collects the player's name via a text input and presents
    clickable game buttons. On selection, exits Textual and returns
    a (player_name, game_id) tuple to main() for terminal UI handoff.

    To wire this into CasinoApp in main.py, a maintainer needs to:
        1. Import HomePage:
               from casino.screens.home import HomePage
        2. Register the screen in CasinoApp:
               SCREENS = {"home": HomePage}
        3. Add on_mount to CasinoApp:
               def on_mount(self) -> None:
                   self.push_screen("home")
        4. Update main() to handle the result:
               result = app.run()
               if isinstance(result, tuple) and len(result) == 2:
                   player_name, game_id = result
                   ...
    """

    CSS = """
    HomePage {
        align: center middle;
    }

    #home-container {
        width: 64;
        height: auto;
        border: double $accent;
        padding: 2 4;
        align: center middle;
    }

    #casino-title {
        text-align: center;
        text-style: bold;
        color: $success;
        margin-bottom: 1;
    }

    #name-label {
        text-align: center;
        color: $text;
        margin-bottom: 1;
    }

    #name-error {
        text-align: center;
        color: $error;
        margin-bottom: 1;
    }

    #name-input {
        margin-bottom: 2;
    }

    #games-label {
        text-align: center;
        color: $text-muted;
        margin-bottom: 1;
    }

    Button {
        width: 100%;
        margin-bottom: 1;
    }
    """

    BINDINGS = [
        Binding("e", "exit_app", "Exit App"),
        Binding("ctrl+c", "exit_app", "Exit App", show=False),
    ]

    def compose(self) -> ComposeResult:
        yield Header()
        with Container(id="home-container"):
            yield Label("♦  T E R M I N A L   C A S I N O  ♦", id="casino-title")
            yield Label("Enter your name:", id="name-label")
            yield Label("", id="name-error")
            yield Input(placeholder="Your name...", id="name-input")
            yield Label("Select a game to play:", id="games-label")
            with Vertical():
                for display_name, game_id in GAMES:
                    yield Button(display_name, id=f"game-{game_id}", variant="primary")
        yield Footer()

    def on_mount(self) -> None:
        """Focus the name input field on load."""
        self.query_one("#name-input", Input).focus()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        """
        Validate name input, then exit Textual and pass
        (player_name, game_id) back to main() for terminal handoff.
        """
        button_id = event.button.id
        if not button_id or not button_id.startswith("game-"):
            return

        name_input = self.query_one("#name-input", Input)
        name_error = self.query_one("#name-error", Label)
        player_name = name_input.value.strip()

        # Enforce name entry before allowing game selection
        if not player_name:
            name_error.update("⚠  Please enter your name before selecting a game.")
            name_input.focus()
            return

        name_error.update("")

        # Strip prefix to match exact GAME_HANDLERS key
        game_id = button_id.removeprefix("game-")

        # Exit Textual cleanly — result is handled by main()
        self.app.exit(result=(player_name, game_id))

    def action_exit_app(self) -> None:
        """Exit the app cleanly with no game selected."""
        self.app.exit()
